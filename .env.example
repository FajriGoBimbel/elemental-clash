# Salin ke .env.local (lokal) atau isi di Vercel → Project Settings → Environment Variables.

# Alamat dasar link undangan "Bagikan link / QR" (?join=KODE).
# Kosong = memakai alamat halaman yang sedang dibuka.
# Contoh produksi: https://elemental-clash.vercel.app
# Contoh uji lokal di HP: http://192.168.1.10:5173
VITE_SHARE_URL=

# Server sinyal PeerJS sendiri untuk Main Bareng versi web (opsional; kosong = cloud publik PeerJS).
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
